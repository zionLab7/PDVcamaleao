generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  document  String?
  phone     String?
  plan      String   @default("pro")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  products      Product[]
  sales         Sale[]
  cashRegisters CashRegister[]
  storeSetting  StoreSetting?
  categories    Category[]
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  username  String
  role      String   @default("cashier") // admin, manager, cashier
  pin       String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales         Sale[]
  cashMovements CashMovement[]

  @@unique([tenantId, username])
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  barcode     String?
  category    String   @default("Mercearia")
  unit        String   @default("UN") // UN, KG, LT, PC, CX
  costPrice   Float    @default(0)
  sellPrice   Float
  stock       Float    @default(0)
  minStock    Float    @default(5)
  quickAccess Boolean  @default(false)
  color       String?
  active      Boolean  @default(true)
  ncm         String   @default("00000000") // 8 dígitos NCM
  cest        String?  @default("")
  cfop        String   @default("5102") // Venda de mercadoria dentro do estado
  origin      String   @default("0")    // 0 - Nacional
  csosn       String   @default("102")  // 102 - Simples Nacional sem crédito
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  saleItems   SaleItem[]
}

model Sale {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sequenceNumber Int      @default(1)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  operatorName   String   @default("Operador")
  customerName   String?
  customerCpf    String?
  subtotal       Float    @default(0)
  discount       Float    @default(0)
  total          Float
  amountPaid     Float    @default(0)
  change         Float    @default(0)
  status         String   @default("completed") // completed, cancelled
  fiscalStatus   String   @default("none")      // none, pending, authorized, rejected, cancelled
  nfceNumber     Int?
  nfceSeries     Int?
  nfceAccessKey  String?  // Chave de 44 dígitos
  nfceProtocol   String?  // Protocolo de autorização SEFAZ
  nfceXml        String?  // XML completo assinado e protocolado
  nfceQrCodeUrl  String?  // URL do QR Code oficial da SEFAZ
  nfceError      String?  // Mensagem de rejeição da SEFAZ se houver
  nfceIssuedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items          SaleItem[]
  payments       SalePayment[]
}

model SaleItem {
  id          String   @id @default(uuid())
  tenantId    String
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  quantity    Float
  unitPrice   Float
  discount    Float    @default(0)
  total       Float
  createdAt   DateTime @default(now())
}

model SalePayment {
  id        String   @id @default(uuid())
  tenantId  String
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    String   // dinheiro, pix, debito, credito, fiado, multiplo
  amount    Float
  details   Json?
  createdAt DateTime @default(now())
}

model CashRegister {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isOpen         Boolean  @default(true)
  openedAt       DateTime @default(now())
  closedAt       DateTime?
  openedBy       String?
  initialAmount  Float    @default(0)
  currentBalance Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  movements      CashMovement[]
}

model CashMovement {
  id             String       @id @default(uuid())
  tenantId       String
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  operatorName   String       @default("Operador")
  type           String       // opening, inflow, outflow, closing
  amount         Float
  reason         String
  createdAt      DateTime     @default(now())
}

model StoreSetting {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeName     String   @default("PDV Camaleão")
  tradeName     String?  @default("")
  document      String?  @default("")
  phone         String?  @default("")
  address       String?  @default("")
  city          String?  @default("")
  pixKey        String?  @default("")
  pixReceiver   String?  @default("")
  pixCity       String?  @default("")
  receiptWidth       String    @default("80mm") // 58mm, 80mm
  receiptFooter      String?   @default("Obrigado pela preferência! Volte sempre!")
  enableSound        Boolean   @default(true)
  
  // Fiscal / NFC-e Fields
  enableNfce          Boolean   @default(false)
  fiscalEnvironment   String    @default("homologacao") // homologacao | producao
  stateUf             String    @default("SP")
  stateRegistration   String?   @default("") // Inscrição Estadual
  taxRegime           String    @default("1") // 1 - Simples Nacional, 3 - Regime Normal
  cscId               String?   @default("") // ID do CSC (ex: "000001")
  cscToken            String?   @default("") // Token CSC alfanumérico da SEFAZ
  certificateA1       String?   // Arquivo .pfx em base64
  certificatePassword String?   // Senha do certificado
  certificateOwner    String?   // Titular / CNPJ extraído do certificado
  certificateExpiresAt DateTime? // Data de expiração do certificado
  nfceSeries          Int       @default(1)
  lastNfceNumber      Int       @default(0)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Category {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  color     String?  @default("#10b981")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}

