# ==============================
# PDV Camaleão - Variáveis de Ambiente
# Copie este arquivo como .env e preencha os valores
# ==============================

# --- Domínio (Traefik) ---
DOMAIN=app.distribuidoragpbrasil.com.br

# --- PostgreSQL ---
POSTGRES_USER=pdv_admin
POSTGRES_PASSWORD=TROCAR_PARA_SENHA_SEGURA
POSTGRES_DB=pdvcamaleao

# --- JWT (gere chaves aleatórias seguras!) ---
JWT_SECRET=TROCAR_PARA_CHAVE_SECRETA_ALEATORIA
JWT_REFRESH_SECRET=TROCAR_PARA_OUTRA_CHAVE_SECRETA_ALEATORIA

# --- CORS ---
CORS_ORIGIN=https://app.distribuidoragpbrasil.com.br
